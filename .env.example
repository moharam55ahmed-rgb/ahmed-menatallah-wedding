# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Get these from https://console.upstash.com after creating a Redis database.
# Copy the "REST API" URL and token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://YOUR_DB_NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Password used to log in to /dashboard.
# Change this to a strong, unique value before deploying.
DASHBOARD_PASSWORD=change_me_before_deploying

# Secret key used to authenticate server-to-server API calls (x-admin-key header).
# Must be long and random. Never expose this in client-side code or NEXT_PUBLIC_ vars.
ADMIN_SECRET_KEY=change_me_to_a_long_random_string
